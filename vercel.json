{
  "buildCommand": "ng build --configuration production",
  "outputDirectory": "dist/sailing-app/browser",
  "rewrites": [
    {
      "source": "/api/meteoalarm/:path*",
      "destination": "https://feeds.meteoalarm.org/api/v1/warnings/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
